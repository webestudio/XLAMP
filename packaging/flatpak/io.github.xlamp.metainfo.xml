<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.xlamp</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>XLAMP Manager</name>
  <summary>Gestión completa del stack LAMP para Linux</summary>
  
  <description>
    <p>
      XLAMP es una aplicación gráfica completa para la gestión del stack LAMP 
      (Linux, Apache, MySQL, PHP) en sistemas Linux.
    </p>
    <p>Características principales:</p>
    <ul>
      <li>Instalación y configuración de Apache, MySQL/MariaDB y PHP</li>
      <li>Gestión de hosts virtuales con dominios .test</li>
      <li>Administración de múltiples versiones de PHP (8.0 - 8.3)</li>
      <li>Gestión de servicios (iniciar, detener, reiniciar)</li>
      <li>Sistema de respaldos automáticos para bases de datos y configuraciones</li>
      <li>Interfaz gráfica intuitiva basada en GTK3</li>
      <li>Compatible con sistemas de pantalla pequeña (13" o menos)</li>
      <li>Detección multi-plataforma (dpkg/rpm/pacman)</li>
    </ul>
  </description>
  
  <launchable type="desktop-id">io.github.xlamp.desktop</launchable>
  
  <screenshots>
    <screenshot type="default">
      <caption>Ventana principal de XLAMP</caption>
